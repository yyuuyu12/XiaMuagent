# ===================================================================
# 爆款文案工坊 · Nginx HTTPS 配置示例
# 通常放在 /etc/nginx/conf.d/app.conf
# 把 app.yyagent.top 替换为你的实际域名后启用
# 证书路径以 certbot 默认签发位置为准，见《部署操作步骤.md》
# ===================================================================

# --- HTTP：全部 301 跳转到 HTTPS ---
server {
    listen 80;
    server_name app.yyagent.top;   # ← 替换为你的域名

    # certbot 续期时的 ACME 校验，保持放行
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 其余请求一律跳 https
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS：正式服务 ---
server {
    listen 443 ssl http2;
    server_name app.yyagent.top;   # ← 替换为你的域名

    # ---- 证书路径（certbot 默认签发位置）----
    ssl_certificate     /etc/letsencrypt/live/app.yyagent.top/fullchain.pem;   # ← 替换域名
    ssl_certificate_key /etc/letsencrypt/live/app.yyagent.top/privkey.pem;     # ← 替换域名

    # ---- TLS 安全基线 ----
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=63072000" always;

    # ---- 上传体积，与后端 80mb 对齐 ----
    client_max_body_size 80m;

    # 前端静态文件
    root /usr/share/nginx/html;
    index index.html;

    # 前端页面
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端 API 反向代理 → 本机 3001
    location /api/ {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # 视频转文字 / 长任务，超时设为 10 分钟
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 60s;
    }
}
